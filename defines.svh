`ifndef DEFINES_SVH
`define DEFINES_SVH

// Architectural Widths & Limits
`define ADDR_WIDTH 16
`define DATA_WIDTH 32
`define APB_MAX_PORTS 4
`define APB_Q_DEPTH 16

// Register Memory Map (Byte Offsets)
`define ADDR_DEVICE_ID 16'h0000
`define ADDR_VERSION 16'h0004
`define ADDR_SWITCH_STATUS 16'h0008
`define ADDR_PORT_STATUS 16'h000C
`define ADDR_GEN_STATUS 16'h0010
`define ADDR_STAT_RX 16'h0014
`define ADDR_STAT_TX 16'h0018
`define ADDR_STAT_DROP 16'h001C
`define ADDR_SWITCH_CTRL 16'h0020
`define ADDR_PORT_ENABLE 16'h0024
`define ADDR_FWD_ENABLE 16'h0028
`define ADDR_GEN_CTRL 16'h002C
`define ADDR_GEN_PKT_CFG 16'h0030
`define ADDR_GEN_INTERVAL 16'h0034
`define ADDR_GEN_COUNT 16'h0038
`define ADDR_IRQ_STATUS 16'h003C
`define ADDR_IRQ_ENABLE 16'h0040
`define ADDR_IRQ_FORCE 16'h0044
`define ADDR_ERR_STATUS 16'h0048
`define ADDR_ERR_ENABLE 16'h004C
`define ADDR_ERR_INJECT 16'h0050
`define ADDR_ERR_COUNT 16'h0054
`define ADDR_ERR_INFO 16'h0058
`define ADDR_LOCK 16'h005C
`define ADDR_SOFT_RESET 16'h0060

// Hardware Reset Values & Keys
`define UNLOCK_KEY 32'hA5A5C3C3
`define RST_DEVICE_ID 32'h02A55357
`define RST_VERSION 32'h00010200
`define RST_PORT_ENABLE 32'h0000000F
`define RST_FWD_ENABLE 32'h0000000F

`endif